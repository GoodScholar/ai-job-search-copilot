# 本地运行时的默认端口。覆盖时请在运行 `pnpm dev` 的 shell 中导出变量。
# 不要将端到端测试的隔离端口用作日常开发端口。
WEB_PORT=3020
API_PORT=3021
POSTGRES_PORT=54320
REDIS_PORT=63790
MINIO_API_PORT=59000
MINIO_CONSOLE_PORT=59001
MAILPIT_HTTP_PORT=58025
MAILPIT_SMTP_PORT=51025

# 职业资料解析默认使用 Fake；仅显式设置 openai 且提供 OPENAI_API_KEY 时使用 Responses。
CAREER_PARSER_ADAPTER=fake
JOB_POSTING_NORMALIZER_ADAPTER=fake
# OPENAI_API_KEY=
# OPENAI_LOW_COST_MODEL=gpt-5.6-luna
