{
  "name": "ai-job-search-copilot",
  "version": "0.1.0-alpha",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": { "node": ">=22.22.2" },
  "devDependencies": {
    "tsx": "4.23.12"
  },
  "scripts": {
    "dev": "node scripts/local-runtime.mjs",
    "demo:alpha": "pnpm test:e2e -- e2e/first-recommendation-journey.spec.ts --grep Alpha --workers=1 --retries=0",
    "dev:test": "exec node scripts/local-runtime.mjs --test",
    "dev:down": "docker compose down",
    "metrics": "tsx apps/worker/src/journey-metrics/cli.ts",
    "test:runtime": "node scripts/local-runtime.test.mjs",
    "test": "pnpm test:runtime && pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "dev:web": "pnpm --filter web dev",
    "lint:web": "pnpm --filter web lint",
    "test:web": "pnpm --filter web test",
    "test:e2e": "pnpm --filter web test:e2e",
    "verify:career-parser:openai": "tsx apps/worker/src/career-import/verify-openai-career-parser.ts",
    "build:web": "pnpm --filter web build"
  }
}
